  {
    "id": "fs-01",
    "tipo": "archivos",
    "dificultad": 0.5,
    "enunciado": "Mueve todos los ficheros .log de /proyecto a la carpeta /proyecto/archivo/ sin tocar el resto de ficheros.",
    "fs_inicial": {
      "/proyecto/a.log": "INFO arranque\nERROR fallo de red\n",
      "/proyecto/b.log": "INFO todo correcto\n",
      "/proyecto/main.py": "print('hola')\n",
      "/proyecto/notas.txt": "pendiente: revisar logs\n"
    },
    "verificacion": {"herramienta": "listar", "args": {"ruta": "/proyecto"}},
    "solucion": {
      "acciones": [
        {"herramienta": "listar", "args": {"ruta": "/proyecto"}},
        {"herramienta": "mover", "args": {"origen": "/proyecto/a.log", "destino": "/proyecto/archivo/a.log"}},
        {"herramienta": "mover", "args": {"origen": "/proyecto/b.log", "destino": "/proyecto/archivo/b.log"}}
      ],
      "respuesta": "Hecho: he movido a.log y b.log a /proyecto/archivo/."
    },
    "errores": [
      {"modo": "exito_falso", "peso": 3,
       "acciones": [
         {"herramienta": "listar", "args": {"ruta": "/proyecto"}},
         {"herramienta": "mover", "args": {"origen": "/proyecto/a.log", "destino": "/proyecto/archivo/a.log"}}
       ],
       "respuesta": "Hecho: he movido todos los .log a /proyecto/archivo/.",
       "correccion": [
         {"herramienta": "mover", "args": {"origen": "/proyecto/b.log", "destino": "/proyecto/archivo/b.log"}}
       ]},
      {"modo": "args_erroneos", "peso": 2,
       "acciones": [
         {"herramienta": "listar", "args": {"ruta": "/proyecto"}},
         {"herramienta": "mover", "args": {"origen": "/proyecto/a.log", "destino": "/proyecto/archivos/a.log"}},
         {"herramienta": "mover", "args": {"origen": "/proyecto/b.log", "destino": "/proyecto/archivos/b.log"}}
       ],
       "respuesta": "Hecho: he movido a.log y b.log a la carpeta de archivo.",
       "correccion": [
         {"herramienta": "mover", "args": {"origen": "/proyecto/archivos/a.log", "destino": "/proyecto/archivo/a.log"}},
         {"herramienta": "mover", "args": {"origen": "/proyecto/archivos/b.log", "destino": "/proyecto/archivo/b.log"}}
       ]},
      {"modo": "bucle", "peso": 1,
       "acciones": [{"herramienta": "listar", "args": {"ruta": "/proyecto"}}]}
    ],
    "graders": [
      {"tipo": "estado_fs",
       "existe": ["/proyecto/archivo/a.log", "/proyecto/archivo/b.log"],
       "no_existe": ["/proyecto/a.log", "/proyecto/b.log"],
       "intactos": ["/proyecto/main.py", "/proyecto/notas.txt"]},
      {"tipo": "trayectoria", "max_pasos": 8}
    ]
  },
